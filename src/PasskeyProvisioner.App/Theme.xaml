<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===================================================================================================
         Design system. Brushes are the single source of colors; their values are replaced at run time by
         Set-AppTheme (Themes.psd1: Rose Pine for dark, Rose Pine Dawn for light). The values below are the
         dark defaults, used until the theme is applied.
         Roles: base = window, surface = cards and fields, overlay = borders, iris = primary accent,
         foam = success, gold = warning, love = error and destructive, pine = information, rose = secondary.
         =================================================================================================== -->

    <Color x:Key="BaseColor">#191724</Color>
    <Color x:Key="SurfaceColor">#1F1D2E</Color>
    <Color x:Key="OverlayColor">#26233A</Color>
    <Color x:Key="MutedColor">#6E6A86</Color>
    <Color x:Key="SubtleColor">#908CAA</Color>
    <Color x:Key="TextColor">#E0DEF4</Color>
    <Color x:Key="LoveColor">#EB6F92</Color>
    <Color x:Key="GoldColor">#F6C177</Color>
    <Color x:Key="RoseColor">#EBBCBA</Color>
    <Color x:Key="PineColor">#31748F</Color>
    <Color x:Key="FoamColor">#9CCFD8</Color>
    <Color x:Key="IrisColor">#C4A7E7</Color>
    <Color x:Key="HighlightLowColor">#21202E</Color>
    <Color x:Key="HighlightMedColor">#403D52</Color>
    <Color x:Key="HighlightHighColor">#524F67</Color>

    <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource BaseColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="LoveBrush" Color="{StaticResource LoveColor}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}"/>
    <SolidColorBrush x:Key="PineBrush" Color="{StaticResource PineColor}"/>
    <SolidColorBrush x:Key="FoamBrush" Color="{StaticResource FoamColor}"/>
    <SolidColorBrush x:Key="IrisBrush" Color="{StaticResource IrisColor}"/>
    <SolidColorBrush x:Key="HighlightLowBrush" Color="{StaticResource HighlightLowColor}"/>
    <SolidColorBrush x:Key="HighlightMedBrush" Color="{StaticResource HighlightMedColor}"/>
    <SolidColorBrush x:Key="HighlightHighBrush" Color="{StaticResource HighlightHighColor}"/>

    <!-- Tinted backgrounds (the accent colors at about 18 percent) for badges, banners and chips -->
    <SolidColorBrush x:Key="LoveTintBrush" Color="#2EEB6F92"/>
    <SolidColorBrush x:Key="GoldTintBrush" Color="#2EF6C177"/>
    <SolidColorBrush x:Key="PineTintBrush" Color="#2E31748F"/>
    <SolidColorBrush x:Key="FoamTintBrush" Color="#2E9CCFD8"/>
    <SolidColorBrush x:Key="IrisTintBrush" Color="#2EC4A7E7"/>
    <SolidColorBrush x:Key="RoseTintBrush" Color="#2EEBBCBA"/>

    <!-- Readable variants for text and icons (accent moved toward the text color until it reaches 4.5:1; see ThemeMath.ps1) -->
    <SolidColorBrush x:Key="LoveTextBrush" Color="#EB6F92"/>
    <SolidColorBrush x:Key="GoldTextBrush" Color="#F6C177"/>
    <SolidColorBrush x:Key="RoseTextBrush" Color="#EBBCBA"/>
    <SolidColorBrush x:Key="PineTextBrush" Color="#31748F"/>
    <SolidColorBrush x:Key="FoamTextBrush" Color="#9CCFD8"/>
    <SolidColorBrush x:Key="IrisTextBrush" Color="#C4A7E7"/>
    <SolidColorBrush x:Key="IrisButtonBrush" Color="#C4A7E7"/>

    <!-- Hover and pressed states of the accent buttons (computed per theme by Set-AppTheme) -->
    <SolidColorBrush x:Key="IrisHoverBrush" Color="#D3BCEE"/>
    <SolidColorBrush x:Key="IrisPressedBrush" Color="#B391DB"/>
    <SolidColorBrush x:Key="LoveHoverBrush" Color="#4DEB6F92"/>
    <SolidColorBrush x:Key="LovePressedBrush" Color="#66EB6F92"/>

    <!-- Typography, spacing scale 4/8/12/16/24, radius 8 (controls) and 12 (cards) -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="CardRadius">12</CornerRadius>

    <!-- Icon glyphs (Segoe Fluent Icons) -->
    <sys:String x:Key="GlyphRegister">&#xE8FA;</sys:String>
    <sys:String x:Key="GlyphKey">&#xE8D7;</sys:String>
    <sys:String x:Key="GlyphLog">&#xE8FD;</sys:String>
    <sys:String x:Key="GlyphInfo">&#xE946;</sys:String>
    <sys:String x:Key="GlyphWarning">&#xE7BA;</sys:String>
    <sys:String x:Key="GlyphCheck">&#xE73E;</sys:String>
    <sys:String x:Key="GlyphClose">&#xE711;</sys:String>
    <sys:String x:Key="GlyphUsb">&#xE88E;</sys:String>
    <sys:String x:Key="GlyphLock">&#xE72E;</sys:String>

    <!-- ============================== Base text styles ============================== -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="SubtleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource LoveTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ============================== Cards and chips ============================== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OverlayBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OverlayBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource PineTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PineBrush}"/>
    </Style>

    <!-- ============================== Buttons ============================== -->

    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </Border>
    </ControlTemplate>

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource IrisButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource IrisButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BaseBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource IrisHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource IrisHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource IrisPressedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource IrisPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OverlayBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HighlightHighBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HighlightMedBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource HighlightHighBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource IrisBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource BaseBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OverlayBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource LoveTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LoveBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource LoveTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LoveHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource LovePressedBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource BaseBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OverlayBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HighlightLowBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource IrisBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== Text input ============================== -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BaseBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HighlightMedBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="CaretBrush" Value="{DynamicResource IrisBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource IrisBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.45"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource HighlightHighBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource IrisBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Invalid">
                <Setter Property="BorderBrush" Value="{DynamicResource LoveBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LogTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

    <!-- ============================== Radio buttons: navigation rail and segmented control ============================== -->

    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" Padding="0,10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Marker" Width="3" Height="22" CornerRadius="2" HorizontalAlignment="Left"
                                Margin="-9,0,0,0" Background="{DynamicResource IrisBrush}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightLowBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IrisTintBrush}"/>
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource IrisTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource IrisBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                            Padding="16,6" MinWidth="72">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightMedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource IrisBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Check box ============================== -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" Background="{DynamicResource BaseBrush}"
                                BorderBrush="{DynamicResource HighlightHighBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource BaseBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource IrisBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource IrisBrush}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource IrisBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Progress ============================== -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource IrisTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4"
                                    HorizontalAlignment="Left"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indeterminate bar: keeps the stock template because it carries the animation. -->
    <Style x:Key="BusyBar" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource IrisTextBrush}"/>
    </Style>

    <!-- ============================== Scroll bars ============================== -->

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource HighlightHighBrush}" CornerRadius="4" Margin="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{DynamicResource HighlightHighBrush}" CornerRadius="4" Margin="2"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== Tool tip ============================== -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HighlightHighBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ============================== Data grid ============================== -->

    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OverlayBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="GridCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource HighlightLowBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HighlightMedBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource HighlightMedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OverlayBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource GridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource GridRow}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    </Style>

    <!-- Status badge used in the enrollment grid. Bound to EnrollRow.Status / StatusText. -->
    <DataTemplate x:Key="StatusBadge">
        <Border x:Name="Badge" CornerRadius="11" Padding="10,3" HorizontalAlignment="Left"
                Background="{DynamicResource OverlayBrush}">
            <TextBlock x:Name="Label" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource SubtleBrush}"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="WaitingForKey">
                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource GoldTintBrush}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource GoldTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Checking">
                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource PineTintBrush}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PineTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Running">
                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource IrisTintBrush}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource IrisTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Registered">
                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource FoamTintBrush}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource FoamTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="AlreadyRegistered">
                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource PineTintBrush}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PineTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Failed">
                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource LoveTintBrush}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource LoveTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource RoseTintBrush}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource RoseTextBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
